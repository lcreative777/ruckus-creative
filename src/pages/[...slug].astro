---
// src/pages/[...slug].astro — Cinema treatment for the 7 standalone pages
// (About, Capabilities, Process, Results, Contact, Privacy, Terms) and the
// 9 knowledge posts. The handoff doesn't design these explicitly.
//
// The 7 pages migrated as flat runs of <p> tags with zero headings — see
// src/lib/content-page.ts for the classifier that re-marks-up that text
// (lead / section heading / pull quote / list / CTA / plain body) and
// src/components/content/{PageHeader,ContentBody}.astro for how it's
// rendered, extending the homepage's own typographic + hairline-grid
// conventions. Legal pages skip the ambient wash and get a tighter reading
// measure, per the handoff's "comfortable measure, no ambient washes"
// instruction.
//
// Knowledge posts are untouched by this pass: RichText body in a span_9
// column beside the sidebarLinks span_3 aside, a 76px top offset to clear
// the fixed header (see Plan 4 Task 7's "KNOWN ISSUE"), and a sparing
// ambient wash behind the top of the page.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Seo from '../components/Seo.astro';
import RichText from '../components/RichText.astro';
import PageHeader from '../components/content/PageHeader.astro';
import ContentBody from '../components/content/ContentBody.astro';
import ServiceList from '../components/content/ServiceList.astro';
import { parseContentBlocks } from '../lib/content-page';
import { site, sidebarLinks, legalLinks } from '../data/site';
import { backgroundFor } from '../lib/backgrounds';

export async function getStaticPaths() {
  const [pages, posts] = await Promise.all([getCollection('pages'), getCollection('knowledge')]);
  const slugOf = (path: string) => path.replace(/^\/|\/$/g, '');

  const fromPages = pages
    .filter(p => !['/', '/portfolio-ruckus/', '/knowledge/'].includes(p.data.path))
    // Index the standalone pages so each draws a distinct header photograph.
    .map((p, i) => ({ params: { slug: slugOf(p.data.path) }, props: { entry: p, kind: 'page' as const, bgIndex: i } }));

  const fromPosts = posts
    .map(p => ({ params: { slug: slugOf(p.data.path) }, props: { entry: p, kind: 'post' as const } }));

  return [...fromPages, ...fromPosts];
}

const { entry, kind, bgIndex } = Astro.props;
const d = entry.data;
const isPost = kind === 'post';
const isLegal = legalLinks.some(l => l.href === d.path);

const breadcrumbs = isPost
  ? [{ name: 'Home', url: '/' }, { name: 'Knowledge', url: '/knowledge/' }, { name: d.title, url: d.path }]
  : [{ name: 'Home', url: '/' }, { name: d.title, url: d.path }];

const schema = isPost && 'pubDate' in d
  ? { '@type': 'Article', headline: d.title, datePublished: d.pubDate.toISOString(),
      author: { '@id': `${site.url}/#organization` }, publisher: { '@id': `${site.url}/#organization` } }
  : undefined;

// The 7 standalone pages (About, Capabilities, Process, Results, Contact,
// Privacy, Terms) migrated as flat runs of <p> tags with zero headings.
// content-page.ts re-marks-up that same text — lead, section heading(s),
// pull quote, list, CTA, plain body — without editing a single word.
// Knowledge posts keep their existing RichText + span_9/span_3 sidebar
// rendering untouched.
const blocks = !isPost ? parseContentBlocks(entry.body ?? '') : null;

// The header photo's credit is rendered in the footer, so resolve it here and
// hand it to both components rather than letting each look it up separately.
const bg = !isPost ? backgroundFor(d.path, bgIndex) : null;
const photoCredit = bg
  ? { photographer: bg.meta.photographer, photographerUrl: bg.meta.photographerUrl }
  : undefined;
---
<Base photoCredit={photoCredit}>
  <Seo slot="head" title={d.seo.title ?? d.title} description={d.seo.description}
       canonical={d.seo.canonical} ogImage={d.seo.ogImage}
       type={isPost ? 'article' : 'website'}
       publishedTime={isPost && 'pubDate' in d ? d.pubDate.toISOString() : undefined}
       breadcrumbs={breadcrumbs} schema={schema} />
  {isPost ? (
    <article class="page">
      <div class="wash" aria-hidden="true"></div>
      <div class="container page-inner">
        <h1>{d.title}</h1>
        {/* No published date on articles — removed at the client's request. The
            date still ships in the Article JSON-LD and og:published_time above,
            where it helps search engines without dating the piece to a reader. */}
        <div class="row">
          <div class="col span_9"><RichText html={entry.body ?? ''} /></div>
          <aside class="col span_3 col_last post-sidebar">
            <nav aria-label="Sections">
              <ul>{sidebarLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul>
            </nav>
          </aside>
        </div>
      </div>
    </article>
  ) : (
    <article class:list={['content-page', { legal: isLegal }]}>
      <PageHeader title={d.title} legal={isLegal} path={d.path} bgIndex={bgIndex} />
      <div class:list={[isLegal ? 'container' : 'container-wide', 'page-inner']}>
        <ContentBody blocks={blocks!} legal={isLegal} />
        {/* Capabilities is the page that names what the agency sells, so it
            carries the canonical service list — rendered from src/data/site.ts,
            the same array behind the OfferCatalog in Seo.astro, so the visible
            copy and the structured data cannot disagree. */}
        {d.path === '/strategic-creative-capabilities/' && <ServiceList />}
      </div>
    </article>
  )}
</Base>

<style>
  /* Knowledge posts: unchanged from before this pass — RichText body in a
     span_9 column beside the sidebarLinks span_3 aside. */
  .page {
    position: relative;
    padding-top: 76px;
    background: var(--color-page-band);
    overflow: hidden;
  }
  .wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 60% at 92% 0%, rgba(41, 73, 232, .16), transparent 65%),
      radial-gradient(45% 55% at 4% 100%, rgba(184, 30, 4, .14), transparent 60%);
  }
  .page-inner { position: relative; padding-block: var(--band-pad); }

  /* The 7 standalone pages: PageHeader already carries the 76px fixed-header
     offset and its own wash/hairline, so the body band here is just the
     content band beneath it. */
  .content-page { background: var(--color-page-band); }
  .content-page .page-inner { padding-block: var(--space-section-block); }

  time {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-flame);
  }
</style>
