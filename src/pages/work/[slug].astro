---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Seo from '../../components/Seo.astro';
import RichText from '../../components/RichText.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map(entry => ({
    params: { slug: entry.data.path.replace('/work/', '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
---
<Base>
  <Seo slot="head" title={d.seo.title ?? d.title} description={d.seo.description}
       canonical={d.seo.canonical} ogImage={d.seo.ogImage}
       breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Work', url: '/portfolio-ruckus/' }, { name: d.title, url: d.path }]}
       schema={{ '@type': 'CreativeWork', name: d.title, url: new URL(d.path, site.url).href,
                 creator: { '@id': `${site.url}/#organization` } }} />
  <div class="work-header"><div class="container"><h1>{d.title}</h1></div></div>
  <article class="container section page-band">
    <RichText html={entry.body ?? ''} />
    <p><a href="/portfolio-ruckus/">← All work</a></p>
  </article>
</Base>

<style>
  /* The live site puts the portfolio title in its own band above the content. */
  .work-header { background: var(--color-bg-dark); color: #fff; padding-block: var(--space-4); }
  .work-header :global(h1) { color: #fff; margin: 0; }
</style>
