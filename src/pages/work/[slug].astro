---
// src/pages/work/[slug].astro — Cinema work case study.
// Per the handoff: brief column left is the entry's span_3 meta, image
// column right is its span_9 media, both extracted from the migrated body
// (see src/lib/work-content.ts) and rendered through RichText.astro. Project
// titles come from home.md via getWorkTiles() — the same verbatim source the
// homepage work grid uses — rather than the collection's `title` field,
// which carries an SEO " - Ruckus Creative" suffix not meant for an H1.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Seo from '../../components/Seo.astro';
import RichText from '../../components/RichText.astro';
import { site } from '../../data/site';
import { getWorkTiles } from '../../lib/home-content';
import { parseCaseStudy } from '../../lib/work-content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map(entry => ({
    params: { slug: entry.data.path.replace('/work/', '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const slug = d.path.replace('/work/', '').replace(/\/$/, '');

const tiles = await getWorkTiles();
const titleBySlug = new Map(tiles.map(t => [t.slug, t.title]));
const title = titleBySlug.get(slug) ?? d.title;

const { imagesHtml, briefHtml } = parseCaseStudy(entry.body ?? '', slug);

// Prev/next follow the canonical running order in home.md -- the same sequence
// the homepage grid presents -- rather than the per-page "Previous Project"
// link the WordPress nav carried. That one had no forward equivalent and left
// the first project with no sibling at all, so the set could only be walked
// backwards and only from the middle.
//
// The order wraps, so every case study has both directions and all 20 can be
// stepped through end to end without returning to the index.
const seq = tiles.length > 1 ? tiles : [];
const at = seq.findIndex((t) => t.slug === slug);
const prev = at >= 0 ? seq[(at - 1 + seq.length) % seq.length] : null;
const next = at >= 0 ? seq[(at + 1) % seq.length] : null;
---
<Base>
  <Seo slot="head" title={d.seo.title ?? d.title} description={d.seo.description}
       canonical={d.seo.canonical} ogImage={d.seo.ogImage}
       breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Work', url: '/portfolio-ruckus/' }, { name: title, url: d.path }]}
       schema={{ '@type': 'CreativeWork', name: title, url: new URL(d.path, site.url).href,
                 creator: { '@id': `${site.url}/#organization` } }} />

  <div class="case">
    <div class="case-top">
      <a href="/#work" class="nav-link back"><span class="caret" aria-hidden="true"></span> Back to all projects</a>
      <h1>{title}</h1>
    </div>

    <div class="case-body">
      <aside class="brief">
        <RichText html={briefHtml} class="prose brief-fields" />
        <a href="/#contact" class="cta-pill">Start a project</a>
      </aside>
      <RichText html={imagesHtml} class="case-images" />
    </div>

    <nav class="case-bottom" aria-label="Project navigation">
      {prev && (
        <a href={`/work/${prev.slug}/`} class="nav-link prev" rel="prev">
          <span class="caret" aria-hidden="true"></span>
          <span class="stack">
            <span class="dir">Previous</span>
            <span class="name">{prev.title}</span>
          </span>
        </a>
      )}
      <a href="/#work" class="nav-link all">All projects</a>
      {next && (
        <a href={`/work/${next.slug}/`} class="nav-link next" rel="next">
          <span class="stack">
            <span class="dir">Next</span>
            <span class="name">{next.title}</span>
          </span>
          <span class="caret forward" aria-hidden="true"></span>
        </a>
      )}
    </nav>
  </div>
</Base>

<style>
  .case { padding-top: 76px; }

  .case-top { padding: clamp(36px, 5vw, 72px) clamp(24px, 5vw, 72px) 0; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color .2s ease;
  }
  .nav-link:hover { color: #fff; }
  .caret {
    width: .5em;
    height: .5em;
    border-top: 2px solid currentColor;
    border-left: 2px solid currentColor;
    transform: rotate(-45deg);
    display: inline-block;
  }
  /* Same chevron mirrored, so back/prev/next read as one family. */
  .caret.forward { transform: rotate(135deg); }

  .case-top h1 {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-weight: 100;
    font-size: clamp(34px, 5.4vw, 78px);
    line-height: 1;
    letter-spacing: -.035em;
    color: #fff;
  }

  .case-body {
    padding: clamp(36px, 4.5vw, 64px) clamp(24px, 5vw, 72px) clamp(64px, 8vw, 110px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  .brief {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 44ch;
  }

  /* Sticky only once the grid above actually has two columns to work with.
     `repeat(auto-fit, minmax(300px, 1fr))` collapses to a single column below
     roughly 680px (2x300 + the 32px gap + 2x24px padding), at which point the
     brief and the images are stacked -- and a sticky brief pinned itself to
     the top of the viewport while the case images scrolled up underneath it.
     760px leaves margin over that 680px threshold so the two never overlap. */
  @media (min-width: 760px) {
    .brief {
      position: sticky;
      top: 104px;   /* clears the 92px fixed header */
    }
  }
  .brief :global(.brief-fields) {
    display: flex;
    flex-direction: column;
    color: var(--color-text-bright);
    line-height: 1.85;
  }
  .brief :global(.brief-fields p) {
    margin: 0;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }
  .brief :global(.brief-fields p + p) { margin-top: 22px; }
  .brief :global(.brief-fields p strong:first-child) {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 10px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--color-flame);
  }
  .cta-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 15px 30px;
    border-radius: var(--radius-pill);
    background: var(--gradient-brand-120);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    transition: filter .2s ease;
  }
  .cta-pill:hover { filter: brightness(1.15); }

  .case-body :global(.case-images) {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.4vw, 32px);
    min-width: 0;
  }
  .case-body :global(.case-images picture),
  .case-body :global(.case-images img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-surface-card);
    margin: 0;
  }

  /* Previous | All projects | Next. A three-column grid rather than flex with
     space-between: the outer links have very different widths (project titles
     vary a lot), and space-between would drift "All projects" off-centre by
     however much they differ. 1fr / auto / 1fr keeps it centred regardless. */
  .case-bottom {
    border-top: 1px solid rgba(255, 255, 255, .1);
    padding: clamp(30px, 4vw, 54px) clamp(24px, 5vw, 72px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px 24px;
  }
  .case-bottom .prev { justify-self: start; }
  .case-bottom .all  { justify-self: center; }
  .case-bottom .next { justify-self: end; text-align: right; }

  /* Direction over project name, so the title is readable at a glance instead
     of buried in a long tracked-out uppercase run. */
  .stack { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .stack .dir { color: var(--color-flame); }
  .stack .name {
    font-size: 12px;
    letter-spacing: .1em;
    color: var(--color-text-bright);
    overflow-wrap: anywhere;
  }
  .nav-link:hover .name { color: #fff; }

  /* Phones: prev and next share the top row, "All projects" sits under them.
     Keeping the pair side by side matters more than the label -- stepping
     through projects is the point of this control. */
  @media (max-width: 640px) {
    .case-bottom { grid-template-columns: 1fr 1fr; }
    .case-bottom .prev { grid-area: 1 / 1; }
    .case-bottom .next { grid-area: 1 / 2; }
    .case-bottom .all  { grid-area: 2 / 1 / 3 / -1; }
    .stack .name { font-size: 11px; }
  }
</style>
