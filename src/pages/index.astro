---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Seo from '../components/Seo.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Intro from '../components/home/Intro.astro';
import Pillars from '../components/home/Pillars.astro';
import Statement from '../components/home/Statement.astro';
import WorkGrid from '../components/home/WorkGrid.astro';
import ProcessRail from '../components/home/ProcessRail.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Stats from '../components/home/Stats.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Capabilities from '../components/home/Capabilities.astro';
import Cta from '../components/home/Cta.astro';
import Contact from '../components/home/Contact.astro';

const entry = (await getCollection('pages')).find(p => p.data.path === '/')!;
const d = entry.data;
---
<Base>
  <Seo slot="head" title={d.seo.title ?? d.title} description={d.seo.description} canonical={d.seo.canonical} ogImage={d.seo.ogImage} />
  <HeroVideo
    playbackId="x8Dj7cq01zoZ4SRWJdrvoUWEpwVj7L5g5wBr01vBe40288"
    title="Play the Ruckus Creative reel"
  />
  <Intro />
  <Pillars />
  <Statement />
  <WorkGrid />
  <ProcessRail />
  <WhyUs />
  <Stats />
  <Testimonials />
  <Capabilities />
  <Cta />
  <Contact />
</Base>
