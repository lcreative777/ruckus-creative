---
interface Props { photoCredit?: { photographer: string; photographerUrl: string } }
const { photoCredit } = Astro.props;
// Fonts: latin subsets only, and only the weights the pages actually render.
//
// The bare '@fontsource/<family>/<weight>.css' entries declare every subset the
// family ships -- latin, latin-ext, cyrillic, greek, vietnamese, and for Open
// Sans also math and symbols. Those last two were really downloading: 29.6KB
// across 2 requests for glyph ranges this site never uses. The 'latin-' files
// declare one subset, so the others cannot be requested at all.
//
// Weights below were measured, not guessed: computed styles were collected
// across the homepage, a content page, a case study, the knowledge index and a
// legal page, and only the combinations that actually appear are imported.
// Dropped as unrendered: Open Sans 300 and 600, Lato 100-italic, Raleway 400.
//
// Lato 300 / 300-italic stay despite nothing asking for 300 directly: a handful
// of elements compute Lato 400, and CSS font matching resolves that down to 300.
// Removing them would silently promote that text to 700.
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-700.css';
import '@fontsource/lato/latin-100.css';
import '@fontsource/lato/latin-300.css';
import '@fontsource/lato/latin-300-italic.css';
import '@fontsource/lato/latin-700.css';
import '@fontsource/lato/latin-900.css';
import '@fontsource/lato/latin-900-italic.css';
import '@fontsource/raleway/latin-200.css';
import '@fontsource/raleway/latin-300.css';
import '@fontsource/raleway/latin-300-italic.css';
// Preloaded below. Imported as assets so the hashed build URLs are used.
import openSans400 from '@fontsource/open-sans/files/open-sans-latin-400-normal.woff2';
import lato700 from '@fontsource/lato/files/lato-latin-700-normal.woff2';
import lato900 from '@fontsource/lato/files/lato-latin-900-normal.woff2';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import favicon from '../assets/chrome/cropped-FAVICON-192x192.png';
import appleIcon from '../assets/chrome/cropped-FAVICON-180x180.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleIcon.src} />
    {/* The three faces that carry almost all rendered text -- Open Sans 400 for
        body copy, Lato 700 and 900 for headings and labels. Without these the
        browser cannot discover any font until it has parsed the stylesheet,
        which delayed every font request to ~370ms. Only three: preloading
        more competes with the CSS and hero image for early bandwidth. */}
    <link rel="preload" href={openSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lato700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lato900} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    {photoCredit && (
      <div class="photo-credit">
        <p>
          Photo by <a href={photoCredit.photographerUrl} rel="noopener nofollow" target="_blank">{photoCredit.photographer}</a>
        </p>
      </div>
    )}
    <Footer />
    <Motion />

    <script>
      // Re-apply the URL's hash once layout has settled.
      //
      // Arriving at /#work from another page lands at the top instead of the
      // section. The browser performs its anchor scroll as soon as the target
      // is parsed, but at that moment the 100vh hero video, the lazily loaded
      // work imagery and the GSAP reveals below it have not resolved, so the
      // section's final offset is not yet known and the scroll is effectively
      // discarded. Nothing re-applies it afterwards. A reload often appears to
      // work only because a warm cache wins the race.
      //
      // Runs on every page: the homepage owns the section ids, but any page
      // can be linked to with a hash.
      {
        const target = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          return id ? document.getElementById(id) : null;
        };

        if (target()) {
          // Never yank the page away from someone who started reading or
          // scrolling while it loaded -- honour their position instead.
          let userMoved = false;
          const claim = () => { userMoved = true; };
          for (const evt of ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const) {
            addEventListener(evt, claim, { once: true, passive: true });
          }

          const settle = () => {
            if (userMoved) return;
            // scroll-margin-top on the section ids (see src/styles/base.css)
            // supplies the fixed-header offset, so this needs no extra maths.
            target()?.scrollIntoView({ block: 'start', behavior: 'auto' });
          };

          addEventListener('load', () => {
            settle();
            // Motion.astro refreshes ScrollTrigger at ~400ms, which can shift
            // offsets again; re-assert just after that.
            setTimeout(settle, 500);
          }, { once: true });
        }
      }
    </script>
  </body>
</html>

<style>
  /* Sits at the very end of the page, just above the footer, right-aligned and
     held to the same measure as the content it credits. The photographer's name
     links to their Unsplash profile, which is the attribution their API
     Guidelines ask for. */
  .photo-credit {
    width: min(100% - 2rem, var(--container-wide));
    margin-inline: auto;
    padding-block: var(--space-3) var(--space-4);
    text-align: right;
  }
  .photo-credit p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .34);
  }
  .photo-credit a { color: rgba(255, 255, 255, .55); text-decoration: none; }
  .photo-credit a:hover { color: #fff; text-decoration: underline; }

  /* Visually hidden until focused, then parked below the fixed header
     (Header.astro) instead of at the very top edge, which the header
     would otherwise cover. A dedicated class, not .visually-hidden,
     since that utility is also used where staying hidden on focus is
     correct (see src/pages/*.astro's visually-hidden <h1>s). */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .skip-link:focus-visible {
    position: fixed;
    top: 90px;
    left: clamp(20px, 4vw, 56px);
    z-index: 100;
    width: auto;
    height: auto;
    padding: .75em 1.25em;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    background: var(--color-surface-card);
    color: var(--color-white);
    border: 1px solid var(--color-hairline-strong);
  }
</style>
