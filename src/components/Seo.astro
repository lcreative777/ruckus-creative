---
// src/components/Seo.astro
import { getImage } from 'astro:assets';
import { site, services } from '../data/site';
// Referenced by the organization's logo/image in the JSON-LD below. Imported
// as assets rather than hardcoded so the URLs follow the hashed build output.
import logo from '../assets/chrome/ruckus_logo_light.png';
import poster from '../assets/media/ruckus_vid-1.jpg';

const logoSrc = logo.src;

// Google's structured-data guidance asks for a high-resolution `image` in at
// least 1200px, and prefers being offered 16:9, 4:3 and 1:1 so it can pick the
// crop that fits a given surface. Supplying only one is what left "Missing
// field image" in the Rich Results Test.
//
// Source is the hero video's poster: the R mark sits centred in a 1676x944
// frame, so a centre cover-crop keeps the whole mark inside every ratio —
// checked against the narrowest case, the 944x944 square.
//
// getImage output is content-hashed per unique parameter set, so these three
// files are emitted once for the whole site rather than per page.
// Sizes are derived from the source rather than hardcoded. Asking for a
// 1200x1200 square silently produced 1200x944 -- Astro will not upscale, and
// the frame is only 944px tall -- which left the JSON-LD advertising
// dimensions the file did not have. Computing the largest crop each ratio can
// actually yield keeps the declaration honest whatever the source becomes.
const MAX_EDGE = 1200; // Google's recommended minimum width
const POSTER_RATIOS = [16 / 9, 4 / 3, 1].map((ratio) => {
  const width = Math.min(poster.width, Math.floor(poster.height * ratio), MAX_EDGE);
  return { width, height: Math.round(width / ratio) };
});

const posterImages = await Promise.all(
  POSTER_RATIOS.map((r) =>
    getImage({
      src: poster,
      format: 'jpeg',
      width: r.width,
      height: r.height,
      fit: 'cover',
      position: 'center',
    }),
  ),
);

interface Props {
  title: string;
  description?: string | null;
  canonical?: string | null;
  ogImage?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string;
  breadcrumbs?: { name: string; url: string }[];
  schema?: Record<string, unknown>;
}
const {
  title, description, canonical, ogImage,
  type = 'website', publishedTime, breadcrumbs, schema,
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, site.url).href;
const desc = description ?? site.description;
const image = ogImage ?? undefined;

// The current site has no structured data at all, so all of this is a net gain.
//
// Typed AdvertisingAgency (a schema.org subtype of LocalBusiness, so it keeps
// every address/telephone property while stating the actual line of business)
// and ProfessionalService, which is how a full-service agency is usually
// modelled. Both inherit from Organization, so the @id below still resolves
// for the Article author/publisher references on the knowledge posts.
//
// Nothing here is invented: every value traces to src/data/site.ts. Properties
// that would require guessing — geo coordinates, opening hours — are omitted
// rather than filled with plausible fiction, which is worse than absent for a
// business listing.
const organization = {
  '@type': ['AdvertisingAgency', 'ProfessionalService'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  alternateName: 'Ruckus Creative Agency',
  url: site.url,
  description: site.description,
  slogan: 'Business results through strategic creative',
  foundingDate: site.founded,
  telephone: site.phone,
  email: site.email,
  logo: {
    '@type': 'ImageObject',
    '@id': `${site.url}/#logo`,
    url: new URL(logoSrc, site.url).href,
  },
  // Three crops of the same frame, not three different pictures — `image`
  // takes a list and Google chooses per surface. The logo stays separate
  // above: `logo` is the brand mark, `image` is what represents the business.
  image: posterImages.map((img, i) => ({
    '@type': 'ImageObject',
    url: new URL(img.src, site.url).href,
    width: POSTER_RATIOS[i].width,
    height: POSTER_RATIOS[i].height,
  })),
  // Client-supplied (2026-08-16): typical engagement range, not a rate card.
  priceRange: '$5,000 - $100,000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed.map((a) => ({ '@type': a.type, name: a.name })),
  // sameAs is how a crawler confirms this organization is the same entity it
  // has seen elsewhere. Emitted only when there is something to point at, so
  // an empty array never ships.
  ...(site.socials.length ? { sameAs: site.socials.map((s) => s.url) } : {}),
  // Topical expertise. Distinct from the offer catalogue below: knowsAbout
  // describes what the agency understands, hasOfferCatalog what it sells.
  knowsAbout: [
    'Brand Strategy',
    'Brand Development',
    'Search Engine Optimization',
    'Answer Engine Optimization',
    'Generative Engine Optimization',
    'Web Design',
    'Web Development',
    'Website Maintenance',
    'Application Development',
    'Advertising',
    'Marketing Strategy',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    '@id': `${site.url}/#services`,
    name: `${site.name} Services`,
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.name,
        alternateName: s.alternateName,
        description: s.description,
        serviceType: s.alternateName,
        provider: { '@id': `${site.url}/#organization` },
      },
    })),
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.phoneE164,
    email: site.email,
    areaServed: site.areaServed.map((a) => a.name),
    availableLanguage: 'English',
  },
};

const graph: Record<string, unknown>[] = [organization];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, site.url).href,
    })),
  });
}
if (schema) graph.push(schema);
---
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={url} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={site.name} />
{image && <meta property="og:image" content={image} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={desc} />
{image && <meta name="twitter:image" content={image} />}

<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
