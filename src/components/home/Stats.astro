---
// src/components/home/Stats.astro
// Values/labels parsed from home.md (src/lib/home-content.ts). Rendered as
// the final formatted text (data-count carries the raw target for Task 8's
// GSAP counter, which zeroes and re-counts only on its own trigger — a
// stale/missing trigger must never leave a visible "0").
import { getStats } from '../../lib/home-content';
import { site } from '../../data/site';

const stats = await getStats();

// Client-specified units. These live OUTSIDE the [data-count] element on
// purpose: the counter sets textContent on that node, so a suffix inside it
// would be wiped the moment the animation ran.
const SUFFIX = [' mil', '+'];
// Share intents for the homepage share row. These were migrated as four
// href="/" placeholders -- the WordPress sharing widget's markup without its
// JavaScript -- so every one of them reloaded the homepage.
//
// Built from site.url rather than the current location because this row only
// ever appears on the homepage, and a static href needs no client JS.
const SHARE_URL = encodeURIComponent(site.url);
const SHARE_TEXT = encodeURIComponent(`${site.name} — ${site.description}`);
const SHARE = [
  { label: 'Facebook',  href: `https://www.facebook.com/sharer/sharer.php?u=${SHARE_URL}` },
  { label: 'X',         href: `https://twitter.com/intent/tweet?url=${SHARE_URL}&text=${SHARE_TEXT}` },
  { label: 'LinkedIn',  href: `https://www.linkedin.com/sharing/share-offsite/?url=${SHARE_URL}` },
  { label: 'Pinterest', href: `https://pinterest.com/pin/create/button/?url=${SHARE_URL}&description=${SHARE_TEXT}` },
];
---
<section class="stats">
  <div class="cell blue">
    <div class="number"><span data-count={stats[0].value}>{stats[0].value.toLocaleString('en-US')}</span><span class="suffix">{SUFFIX[0]}</span></div>
    <div class="label">{stats[0].label}</div>
  </div>
  <div class="cell red">
    <div class="number"><span data-count={stats[1].value}>{stats[1].value.toLocaleString('en-US')}</span><span class="suffix">{SUFFIX[1]}</span></div>
    <div class="label">{stats[1].label}</div>
  </div>
  <div class="cell share">
    <span>Share</span>
    {SHARE.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
    ))}
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap-hairline);
    background: var(--color-hairline);
  }
  .cell {
    position: relative;
    padding: clamp(40px, 4.4vw, 64px) clamp(24px, 3vw, 44px);
    overflow: hidden;
  }
  .cell.blue { background: linear-gradient(140deg, var(--color-signal-blue), var(--color-deep-blue)); color: #fff; }
  .cell.red { background: linear-gradient(140deg, var(--color-blue-93), var(--color-ink-red)); color: #fff; }
  .number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1;
  }
  .label {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .cell.share {
    background: var(--color-surface-card);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }
  .cell.share a { color: #fff; text-decoration: none; }
  .cell.share a:hover { color: var(--color-flame); }
</style>
