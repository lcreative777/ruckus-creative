---
// src/components/home/ProcessRail.astro
// Titles/bodies parsed from home.md (src/lib/home-content.ts), including the
// "(+)" suffixes the source authored. Icon choice + step numbering per the
// handoff § Assets → Icons.
import Icon from '../Icon.astro';
import { getProcessSteps } from '../../lib/home-content';

const steps = await getProcessSteps();
const icons = [
  'foundation',                 // FOUNDATION — client-supplied icon
  'mobile-device-svgrepo-com',  // VALIDATION
  'presentation-svgrepo-com',   // INNOVATION
  'fast-svgrepo-com',           // IMPLEMENTATION
  'chart-gear-svgrepo-com',     // EVALUATION
];
---
<section id="about" class="process">
  <div class="wash" aria-hidden="true"></div>
  <div class="head">
    <h2 data-reveal>BRAND ALIGNMENT PROCESS™</h2>
    <div class="head-right">
      <span class="meta">Five stages</span>
      {/* The rail was scrollable but had no affordance: trackpad users could
          swipe it, mouse-only users could not move it at all. Hidden until the
          script confirms the content actually overflows. */}
      <div class="nav" data-process-nav hidden>
        <button type="button" data-process-prev aria-label="Previous stages" aria-controls="process-rail">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18 9 12l6-6"/>
          </svg>
        </button>
        <button type="button" data-process-next aria-label="Next stages" aria-controls="process-rail">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="rail" id="process-rail" data-process-track>
    {steps.map((step, i) => (
      <div class="card" data-reveal data-step>
        <span class="icon"><Icon name={icons[i]} size={36} /></span>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h4>{step.title}</h4>
        <p>{step.body}</p>
      </div>
    ))}
  </div>
  <div class="track">
    <div class="progress" data-process-progress></div>
  </div>
</section>

<script>
  for (const rail of document.querySelectorAll<HTMLElement>('[data-process-track]')) {
    const bar = rail.parentElement?.querySelector<HTMLElement>('[data-process-progress]');
    if (!bar) continue;
    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const pct = max > 0 ? (rail.scrollLeft / max) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(12, pct))}%`;
    };
    update();
    rail.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);

    // --- Slider controls -------------------------------------------------
    const wrap = rail.closest('section');
    const nav = wrap?.querySelector<HTMLElement>('[data-process-nav]');
    const prev = wrap?.querySelector<HTMLButtonElement>('[data-process-prev]');
    const next = wrap?.querySelector<HTMLButtonElement>('[data-process-next]');
    if (!nav || !prev || !next) continue;

    const overflows = () => rail.scrollWidth - rail.clientWidth > 1;

    /** One card plus its gap, so a click advances exactly one stage. */
    const step = () => {
      const card = rail.querySelector<HTMLElement>('[data-step]');
      if (!card) return rail.clientWidth * 0.8;
      const gap = parseFloat(getComputedStyle(rail).columnGap || '0') || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const syncButtons = () => {
      // Only offer controls when there is actually something to scroll to.
      nav.hidden = !overflows();
      const max = rail.scrollWidth - rail.clientWidth;
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= max - 1;
    };

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nudge = (dir: number) =>
      rail.scrollBy({ left: dir * step(), behavior: reduced ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => nudge(-1));
    next.addEventListener('click', () => nudge(1));
    rail.addEventListener('scroll', syncButtons, { passive: true });
    addEventListener('resize', syncButtons);
    syncButtons();

    // Drag to pan, for mouse users who have no horizontal wheel axis.
    let down = false, startX = 0, startLeft = 0, moved = false;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;   // native touch scrolling is better
      down = true; moved = false;
      startX = e.clientX; startLeft = rail.scrollLeft;
    });
    rail.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) { moved = true; rail.classList.add('dragging'); }
      rail.scrollLeft = startLeft - dx;
    });
    const endDrag = () => { down = false; rail.classList.remove('dragging'); };
    rail.addEventListener('pointerup', endDrag);
    rail.addEventListener('pointercancel', endDrag);
    rail.addEventListener('pointerleave', endDrag);
    // Suppress the click that follows a drag, so panning never triggers a link.
    rail.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  }
</script>

<style>
  .process {
    position: relative;
    padding: clamp(72px, 9vw, 128px) 0;
    background: var(--color-surface-raised);
    overflow: hidden;
  }
  .wash {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 55% at 88% 12%, rgba(41, 73, 232, .3), transparent 65%),
      radial-gradient(55% 50% at 6% 90%, rgba(184, 30, 4, .26), transparent 62%);
  }
  .head {
    position: relative;
    padding: 0 clamp(24px, 5vw, 72px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 4vw, 52px);
  }
  .head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    font-size: var(--type-process-h2);
    line-height: 1;
    letter-spacing: var(--type-process-h2-ls);
    color: #fff;
    text-transform: uppercase;
  }
  .meta {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  /* Slider controls. The rail always scrolled, but with no affordance a
     mouse-only visitor had no way to reach the stages past the fold. */
  .head-right { display: flex; align-items: center; gap: clamp(16px, 2vw, 28px); }
  .nav { display: flex; gap: 8px; }
  .nav[hidden] { display: none; }
  .nav button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--color-hairline-strong);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background .25s ease, border-color .25s ease, opacity .25s ease;
  }
  .nav button:hover:not(:disabled) {
    background: var(--color-flame);
    border-color: var(--color-flame);
  }
  .nav button:disabled { opacity: .28; cursor: default; }

  /* Only while a pointer drag is in progress, so the cursor doesn't imply
     draggability on touch devices where native scrolling already works. */
  .rail.dragging { cursor: grabbing; user-select: none; }

  @media (prefers-reduced-motion: reduce) {
    .nav button { transition: none; }
  }

  .rail {
    position: relative;
    display: flex;
    gap: var(--gap-rail);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0 clamp(24px, 5vw, 72px) 10px;
  }
  .rail::-webkit-scrollbar { display: none; }

  .card {
    flex: 0 0 clamp(280px, 26vw, 380px);
    scroll-snap-align: start;
    background: var(--color-surface-card-a86);
    border: 1px solid var(--color-hairline-strong);
    padding: var(--space-card-pad);
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 330px;
    transition: border-color .4s ease, transform .5s var(--ease-primary), background .4s ease;
  }
  .card:hover { border-color: rgba(246, 101, 60, .65); transform: translateY(-6px); }
  .card .icon { color: var(--color-flame); }
  .card .num {
    font-family: var(--font-display);
    font-size: var(--type-step-number);
    font-weight: 700;
    letter-spacing: var(--type-step-number-ls);
    color: var(--color-flame);
  }
  .card h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 19px;
    letter-spacing: .04em;
    color: #fff;
    text-transform: uppercase;
  }
  .card p { margin: 0; font-size: 14px; line-height: 1.85; }

  .track {
    position: relative;
    margin: 28px clamp(24px, 5vw, 72px) 0;
    height: 2px;
    background: var(--color-hairline-strong);
  }
  .progress {
    position: absolute; inset: 0 auto 0 0;
    width: 12%;
    background: var(--gradient-brand-90);
  }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>
