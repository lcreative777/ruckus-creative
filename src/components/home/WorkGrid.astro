---
// src/components/home/WorkGrid.astro
// All 20 tiles, order/title/thumbnail parsed from home.md (src/lib/home-content.ts)
// rather than a hardcoded array, per the handoff.
import { getImage } from 'astro:assets';
import { resolveMedia } from '../../lib/images';
import { getWorkTiles } from '../../lib/home-content';

const tiles = await getWorkTiles();

const images = await Promise.all(
  tiles.map(async (tile) => {
    const img = resolveMedia(tile.thumbnail);
    if (!img) throw new Error(`WorkGrid: "${tile.thumbnail}" was not found in src/assets/media/`);
    const [avif, webp, fallback] = await Promise.all([
      getImage({ src: img, format: 'avif', widths: [340, 480, 680] }),
      getImage({ src: img, format: 'webp', widths: [340, 480, 680] }),
      getImage({ src: img, format: 'jpeg', width: 680 }),
    ]);
    return { avif, webp, fallback, width: img.width, height: img.height };
  })
);
---
<section id="work" class="work">
  <div class="head">
    <h2 data-reveal>Selected <span class="italic">work</span></h2>
    <span class="meta">20 projects · every link live</span>
  </div>
  <div class="grid">
    {tiles.map((tile, i) => {
      const { avif, webp, fallback, width, height } = images[i];
      return (
        <a href={`/work/${tile.slug}/`} class="tile" data-reveal data-work-tile>
          <picture>
            <source type="image/avif" srcset={avif.srcSet.attribute} sizes="(max-width: 900px) 50vw, 340px" />
            <source type="image/webp" srcset={webp.srcSet.attribute} sizes="(max-width: 900px) 50vw, 340px" />
            <img src={fallback.src} width={width} height={height} alt={tile.title} loading="lazy" decoding="async" />
          </picture>
          <span class="caption">
            <span class="title">{tile.title}</span>
            <span class="cta">View case study →</span>
          </span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .work { padding: clamp(64px, 8vw, 110px) 0 0; }
  .head {
    padding: 0 clamp(24px, 5vw, 72px) clamp(28px, 4vw, 48px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 100;
    font-size: clamp(32px, 4.6vw, 66px);
    line-height: 1;
    letter-spacing: -.03em;
    color: #fff;
  }
  .head h2 .italic { font-weight: 900; font-style: italic; }
  .meta {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 0;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    text-decoration: none;
    background: var(--color-surface-card);
  }
  .tile picture, .tile img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .tile img {
    filter: saturate(.3) brightness(.72);
    transition: transform 1s var(--ease-primary), filter .6s ease;
    will-change: transform;
  }
  .tile:hover img, .tile:focus-visible img {
    transform: scale(1.07);
    filter: none;
  }
  .caption {
    position: absolute; inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 7px;
    padding: 22px;
    background: linear-gradient(180deg, rgba(18, 17, 16, 0) 38%, rgba(18, 17, 16, .92) 100%);
    opacity: 0;
    transition: opacity .45s ease;
  }
  .tile:hover .caption, .tile:focus-visible .caption { opacity: 1; }
  /* Hover doesn't exist on touch, so a hover-only caption would leave every
     tile's title permanently unreachable there — always show it and drop
     the desaturation instead, on any device that can't hover. */
  @media (hover: none) {
    .tile img { filter: none; }
    .caption { opacity: 1; }
  }
  .caption .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 14px;
    line-height: 1.25;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #fff;
  }
  .caption .cta {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--color-flame);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile img, .caption { transition: none; }
  }
</style>
